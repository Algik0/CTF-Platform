/*
 * cipher_stamp -- Lupin'sche "Feldchiffre", Altlast aus den 2010er Jahren.
 * TEMPLATE: __KEY__ wird von infra/entrypoint.sh beim Containerstart
 * durch einen pro Deployment zufälligen 6-Zeichen-Schlüssel ersetzt und
 * dann frisch kompiliert (siehe ARCHITECTURE.md, "Dynamic Secrets").
 * Dadurch landet der Schlüssel NIE im Docker-Image, sondern nur in der
 * zur Laufzeit erzeugten Binary im Container.
 *
 * Absichtlich für Reversing-Übungen gebaut: der Schlüssel liegt im
 * Klartext im .rodata-Segment und ist mit `strings` sofort sichtbar.
 */
#include <stdio.h>
#include <unistd.h>

static const unsigned char LUPIN_FIELD_KEY[] = "__KEY__"; /* 6 Byte -- viel zu kurz */
#define KEY_LEN 6

/* Kein Teil der Chiffre -- nur ein Gruß an alle, die `strings` benutzen. */
static const char TAUNT[] = "Salut Ganimard. Sie sind wieder zu langsam.";

int main(void) {
    fprintf(stderr, "[cipher_stamp] %s\n", TAUNT);

    unsigned char buf[65536];
    ssize_t n;
    size_t ctr = 0;

    while ((n = read(STDIN_FILENO, buf, sizeof(buf))) > 0) {
        for (ssize_t j = 0; j < n; j++) {
            buf[j] ^= LUPIN_FIELD_KEY[ctr % KEY_LEN];
            ctr++;
        }
        if (write(STDOUT_FILENO, buf, (size_t)n) != n) {
            return 1;
        }
    }
    return 0;
}
